# GEMINI_API_KEY: Required for Gemini AI API calls (if server-side AI features are enabled).
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# SUPABASE CONFIGURATION (Public client keys only — never place service_role keys here)
# Leave unset to run FarmAccess in interactive Demonstration Mode with local persistence.
VITE_SUPABASE_URL="https://your-project-id.supabase.co"
VITE_SUPABASE_ANON_KEY="your-public-anon-key"
